#!/bin/zsh
# Run the prospecting CLI with this project's virtualenv.
ROOT="$(cd "$(dirname "$0")" && pwd)"
PYTHON="$ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  echo "Missing $PYTHON. From $ROOT, run: python3.12 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec "$PYTHON" "$ROOT/main.py" "$@"
